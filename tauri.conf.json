{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeikiCtrl",
  "version": "0.4.0",
  "identifier": "com.meikitoow.meikictrl",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "Meikitoow",
    "copyright": "© 2026 Meikitoow",
    "category": "Utility",
    "shortDescription": "Overlay manette 3D, émulation Xbox et réglages de manette",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  },
  "mainBinaryName": "MeikiCtrl"
}